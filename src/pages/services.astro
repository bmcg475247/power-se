---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { servicesPageContent } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";

import servicesHeroImage from "../assets/services/services-hero.png";

const { hero, intro, items, cta } = servicesPageContent;
---

<BaseLayout
  title="Services | Power Systems Experts Inc."
  description="Electrical engineering services for arc flash studies, CSA Z462 compliance, power quality, coordination studies, short circuit reports, and engineering investigations."
>
  <Header />
  <main class="bg-white">
    <section class="relative overflow-hidden bg-[var(--color-surface)] text-white">
      <div
        class="absolute inset-0 opacity-[0.58]"
        style={`background-image: linear-gradient(90deg, rgba(20, 19, 22, 0.96), rgba(20, 19, 22, 0.7), rgba(20, 19, 22, 0.32)), url(${servicesHeroImage.src}); background-size: cover; background-position: center;`}
      ></div>
      <div class="section-shell relative py-24 md:py-32 lg:py-40">
        <div class="max-w-[21rem] sm:max-w-3xl">
          <p class="hero-kicker">{hero.eyebrow}</p>
          <h1 class="display-font text-5xl leading-none tracking-[-0.04em] md:text-7xl">{hero.title}</h1>
          <p class="mt-6 max-w-[20rem] text-lg leading-8 text-white/88 sm:max-w-2xl md:text-xl">{hero.description}</p>
          <div class="mt-8 flex w-full max-w-[20rem] flex-col gap-3 sm:max-w-none sm:flex-row">
            <a
              href="#service-list"
              class="inline-flex min-w-0 items-center justify-center rounded-lg bg-[var(--color-primary)] px-7 py-4 text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]"
            >
              Explore Services
            </a>
            <a
              href="#service-inquiry"
              class="inline-flex min-w-0 items-center justify-center rounded-lg border border-white/24 px-7 py-4 text-sm font-extrabold text-white transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
            >
              Start a Project
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell py-18 md:py-24">
      <div class="mx-auto max-w-[21rem] text-center sm:max-w-3xl">
        <p class="section-eyebrow">{intro.eyebrow}</p>
        <h2 class="section-title mt-4">{intro.title}</h2>
        <p class="mt-5 text-lg leading-8 text-[var(--color-ink)]/84">{intro.description}</p>
      </div>
    </section>

    <section id="service-list" class="section-shell service-list-clean scroll-mt-28 pb-20 md:scroll-mt-32 md:pb-28">
      <div class="grid gap-5">
        {items.map((item, index) => (
          <article id={item.slug} class="service-text-card">
            <div class="service-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="service-text-content">
              <h2 class="display-font text-3xl leading-tight tracking-[-0.03em] text-[var(--color-ink)] md:text-4xl">
                {item.title}
              </h2>
              <div class="mt-5 grid gap-4 text-[0.98rem] leading-7 text-[var(--color-ink)]/84">
                {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>

            <aside class="service-outcomes" aria-label={`${item.title} outcomes`}>
              <p>Key Outcomes</p>
              <ul>
                {item.bullets.map((bullet) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </aside>
          </article>
        ))}
      </div>
    </section>

    <section id="service-inquiry" class="section-shell scroll-mt-28 pb-20 md:scroll-mt-32 md:pb-28">
      <div class="services-inquiry-card">
        <div>
          <p class="text-[0.78rem] font-extrabold uppercase tracking-[0.22em] text-[var(--color-primary)]">Project Inquiry</p>
          <h2 class="display-font mt-4 text-4xl leading-tight text-white md:text-5xl">{cta.title}</h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-white/88 md:text-lg">{cta.description}</p>
        </div>

        <form
          name="services-page-inquiry"
          action="/services/"
          method="post"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="grid gap-4 rounded-2xl border border-white/12 bg-white/[0.07] p-5 sm:p-6"
        >
          <input type="hidden" name="form-name" value="services-page-inquiry" />
          <p class="hidden">
            <label>Do not fill this out if you are human: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-4 md:grid-cols-2">
            <input required type="text" name="name" placeholder="Name" class="services-form-input" />
            <input type="text" name="company" placeholder="Company" class="services-form-input" />
            <input required type="email" name="email" placeholder="Email" class="services-form-input" />
            <input type="tel" name="phone" placeholder="Phone" class="services-form-input" />
          </div>

          <select name="service_interest" class="services-form-input bg-[#2b2a2e]">
            <option value="">Which service are you interested in?</option>
            {items.map((item) => <option>{item.title}</option>)}
          </select>

          <textarea
            required
            name="project_information"
            rows="6"
            placeholder="Tell us about your facility, timeline, project goals, or issue you are trying to solve."
            class="services-form-input resize-y leading-6"
          ></textarea>

          <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-[var(--color-primary)] px-7 py-4 text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]">
            {cta.primaryLabel}
          </button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

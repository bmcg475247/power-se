---
import AboutSection from "../components/AboutSection.astro";
import DeliverablesSection from "../components/DeliverablesSection.astro";
import FAQSection from "../components/FAQSection.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ProofSection from "../components/ProofSection.astro";
import Services from "../components/Services.astro";
import { homepageContent } from "../data/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />
  <main>
    <Hero content={homepageContent.hero} />
    <Services content={homepageContent.services} />
    <AboutSection content={homepageContent.why} />
    <DeliverablesSection content={homepageContent.deliverables} />
    <FAQSection content={homepageContent.faq} />
    <ProofSection content={homepageContent.industries} />
    <ProcessSection content={homepageContent.cta} />
  </main>
  <Footer />
</BaseLayout>

---
import type { HomepageContent } from "../types/content";

type Props = {
  content: HomepageContent["why"];
};

const { content } = Astro.props;
---

<section id="about" class="dark-panel py-20 md:py-28">
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="display-font text-4xl leading-tight text-white md:text-5xl">{content.title}</h2>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {content.items.map((item) => (
        <div class="why-item-lite">
          <h3 class="text-lg font-extrabold text-[var(--color-primary)]">{item.title}</h3>
          <p class="mt-3 max-w-xl text-[0.96rem] leading-7 text-white/72">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
import type { HomepageContent } from "../types/content";

type Props = {
  content: HomepageContent["industries"];
};

const { content } = Astro.props;
---

<section class="section-shell py-20 md:py-28">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="section-title">{content.eyebrow}</h2>
    <p class="mt-3 text-lg leading-8 text-[var(--color-ink)]/84">{content.title}</p>
  </div>

  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {content.items.map((item) => (
      <article class="industry-card-lite">
        <h3 class="text-[1rem] font-extrabold leading-tight text-[var(--color-ink)]">{item.title}</h3>
        <p class="mt-3 text-[0.9rem] leading-7 text-[var(--color-ink)]/84">{item.description}</p>
      </article>
    ))}
  </div>
</section>

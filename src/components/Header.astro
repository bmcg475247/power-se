---
import logo from "../assets/pse-logo.png";
import { navigation, siteConfig } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActiveNavItem = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return href.startsWith("/") && pathname === href.replace(/\/$/, "");
};
---

<header id="top" class="relative z-20 bg-[var(--color-surface)]">
  <div id="top-contact-bar" class="border-b border-white/10 bg-[var(--color-surface)] text-sm text-white">
    <div class="section-shell flex flex-wrap items-center justify-center gap-x-4 gap-y-1 py-1.5 text-[0.72rem] text-white/88 sm:min-h-[2.1rem] sm:justify-end sm:gap-6 sm:py-0 sm:text-[0.88rem]">
      <a class="transition hover:text-white" href={`tel:${siteConfig.phone.replace(/[^\d+]/g, "")}`}>{siteConfig.phone}</a>
      <a class="transition hover:text-white" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
  </div>

  <div class="h-[4.45rem] bg-[var(--color-surface)]"></div>

  <div id="main-nav-bar" class="fixed inset-x-0 z-40 border-b border-white/10 bg-[var(--color-surface)]/98">
    <div class="section-shell">
      <div class="flex min-h-[4.45rem] items-center justify-between gap-2 sm:gap-3">
        <div class="flex min-w-0 items-center gap-2.5 sm:gap-3">
          <button
            id="mobile-menu-button"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-white/12 bg-white/6 text-white transition hover:bg-white/10 lg:hidden"
          >
            <span class="flex w-5 flex-col gap-1.5">
              <span class="block h-0.5 w-full rounded-full bg-current"></span>
              <span class="block h-0.5 w-full rounded-full bg-current"></span>
              <span class="block h-0.5 w-full rounded-full bg-current"></span>
            </span>
          </button>

          <a href="/" class="flex min-w-0 items-center gap-1.5 sm:gap-3">
            <img src={logo.src} alt="Power Systems Experts logo" class="h-8 w-8 shrink-0 object-contain sm:h-10 sm:w-10 lg:h-12 lg:w-12" />
            <span class="min-w-0 truncate text-[0.72rem] font-semibold tracking-[0.04em] text-white min-[380px]:text-[0.78rem] sm:hidden">POWER SYSTEMS</span>
            <span class="hidden whitespace-nowrap text-[0.92rem] font-semibold tracking-[0.08em] text-white sm:inline xl:text-[1.08rem]">
              POWER SYSTEMS EXPERTS
            </span>
          </a>
        </div>

        <div class="hidden items-center justify-end gap-8 lg:ml-auto lg:flex">
          <nav class="flex items-center gap-6 text-sm font-semibold text-white">
            {navigation.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "inline-flex items-center border-b border-transparent pb-1 transition hover:border-white/38 hover:text-white/60",
                  isActiveNavItem(item.href) ? "text-white/60" : "text-white"
                ]}
              >
                {item.label}
              </a>
            ))}
            <a
              href={siteConfig.linkedin}
              target="_blank"
              rel="noreferrer"
              aria-label="LinkedIn"
              class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-white/10 text-white transition hover:bg-white/18"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path>
              </svg>
            </a>
          </nav>

          <a
            href="/#cta"
            class="shrink-0 rounded-md bg-[var(--color-primary)] px-4 py-2.5 text-sm font-bold text-black transition hover:bg-[var(--color-mist)]"
          >
            Get a Quote
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-menu-overlay"
  class="pointer-events-none fixed inset-0 z-[45] bg-black/55 opacity-0 transition duration-200 lg:hidden"
  aria-hidden="true"
></div>

<aside
  id="mobile-menu-panel"
  class="pointer-events-none fixed inset-y-0 right-0 z-50 flex w-[min(88vw,22rem)] translate-x-full flex-col bg-[var(--color-surface)] px-6 pb-6 pt-5 shadow-[-24px_0_60px_rgba(0,0,0,0.35)] transition duration-300 lg:hidden"
  aria-hidden="true"
>
  <div class="flex items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2.5">
      <img src={logo.src} alt="Power Systems Experts logo" class="h-10 w-10 shrink-0 object-contain" />
      <span class="min-w-0 truncate text-[0.82rem] font-semibold tracking-[0.06em] text-white min-[380px]:text-[0.9rem]">POWER SYSTEMS EXPERTS</span>
    </div>
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-white/12 bg-white/6 text-white transition hover:bg-white/10"
    >
      <span class="text-xl leading-none">×</span>
    </button>
  </div>

  <nav class="mt-8 flex flex-col gap-1 text-base font-semibold text-white">
    {navigation.map((item) => (
      <a
        href={item.href}
        class:list={[
          "rounded-lg px-4 py-3 transition hover:bg-white/8 hover:text-white/72",
          isActiveNavItem(item.href) ? "bg-white/8 text-white/72" : "text-white"
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mt-auto border-t border-white/10 pt-6 text-sm text-white/86">
    <a class="block py-1 transition hover:text-white" href={`tel:${siteConfig.phone.replace(/[^\d+]/g, "")}`}>{siteConfig.phone}</a>
    <a class="block py-1 transition hover:text-white" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
  </div>
</aside>

<script>
  const contactBar = document.getElementById("top-contact-bar");
  const navBar = document.getElementById("main-nav-bar");
  const menuButton = document.getElementById("mobile-menu-button");
  const menuClose = document.getElementById("mobile-menu-close");
  const menuOverlay = document.getElementById("mobile-menu-overlay");
  const menuPanel = document.getElementById("mobile-menu-panel");

  if (contactBar && navBar) {
    const syncNavOffset = () => {
      const contactHeight = contactBar.offsetHeight;
      navBar.style.top = `${Math.max(contactHeight - window.scrollY, 0)}px`;
    };

    syncNavOffset();
    window.addEventListener("scroll", syncNavOffset, { passive: true });
    window.addEventListener("resize", syncNavOffset);
  }

  if (menuButton && menuClose && menuOverlay && menuPanel) {
    const openMenu = () => {
      menuButton.setAttribute("aria-expanded", "true");
      menuPanel.setAttribute("aria-hidden", "false");
      menuOverlay.setAttribute("aria-hidden", "false");
      menuPanel.classList.remove("translate-x-full", "pointer-events-none");
      menuPanel.classList.add("translate-x-0");
      menuOverlay.classList.remove("opacity-0", "pointer-events-none");
      menuOverlay.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      menuButton.setAttribute("aria-expanded", "false");
      menuPanel.setAttribute("aria-hidden", "true");
      menuOverlay.setAttribute("aria-hidden", "true");
      menuPanel.classList.add("translate-x-full", "pointer-events-none");
      menuPanel.classList.remove("translate-x-0");
      menuOverlay.classList.add("opacity-0", "pointer-events-none");
      menuOverlay.classList.remove("opacity-100");
      document.body.style.overflow = "";
    };

    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuClose.addEventListener("click", closeMenu);
    menuOverlay.addEventListener("click", closeMenu);
    menuPanel.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });
  }

</script>

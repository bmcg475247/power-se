---
import heroBackground from "../assets/hero-industrial-bg.png";
import type { HeroContent } from "../types/content";

type Props = {
  content: HeroContent;
};

const { content } = Astro.props;
---

<section class="hero-rim relative overflow-hidden pb-10 pt-4 md:pb-14 md:pt-8 lg:min-h-[calc(100svh-6.55rem)]">
  <div
    class="absolute inset-0 -z-10 rounded-none bg-cover bg-center"
    style={`background-image: linear-gradient(rgba(0, 0, 0, 0.56), rgba(0, 0, 0, 0.56)), url(${heroBackground.src});`}
  ></div>
  <div class="section-shell flex min-h-[inherit] min-w-0 items-center">
    <div class="flex min-w-0 w-full flex-col gap-6 py-3 md:py-5 lg:grid lg:grid-cols-[minmax(0,1fr)_20.5rem] lg:items-start lg:gap-10">
      <div class="min-w-0 max-w-none lg:max-w-3xl">
        <p class="hero-kicker">{content.eyebrow}</p>
        <h1 class="display-font max-w-[10ch] text-[2.35rem] leading-[1.02] tracking-[-0.03em] text-white sm:max-w-[11ch] sm:text-[2.85rem] md:text-[3.35rem] xl:text-[4rem]">
          Arc Flash Compliance
          <br />
          &amp; Power Systems Optimization
        </h1>
        <p class="mt-4 max-w-[34ch] text-[0.97rem] leading-6 text-white/86 sm:mt-6 sm:max-w-2xl sm:text-[1.02rem] sm:leading-7 md:text-[1.08rem]">
          {content.description}
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:max-w-sm lg:hidden">
          <a
            href="#mobile-quote-form"
            class="inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-primary)] px-6 py-3 text-center text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]"
          >
            {content.primaryCta.label}
          </a>
          <a
            href={content.secondaryCta.href}
            class="inline-flex w-full items-center justify-center rounded-lg border border-[var(--color-primary)] bg-transparent px-4 py-3 text-center text-[0.95rem] leading-5 font-extrabold text-white transition hover:bg-white/6"
          >
            {content.secondaryCta.label}
          </a>
        </div>
      </div>

      <aside class="hidden min-w-0 w-full rounded-xl border border-white/12 bg-[rgba(25,24,27,0.88)] p-5 shadow-[0_24px_80px_rgba(0,0,0,0.28)] backdrop-blur-md lg:block">
        <p class="text-[0.78rem] font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">Contact Us</p>
        <h2 class="mt-2 text-[1.9rem] font-extrabold leading-tight text-white">Request a Quote</h2>
        <p class="mt-2 text-[0.92rem] leading-6 text-white/72 sm:text-sm sm:leading-5">
          Share a few details and our team can follow up about your facility, timing, and project needs.
        </p>

        <form
          name="homepage-quote"
          action="/"
          method="post"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-4 grid gap-2.5"
        >
          <input type="hidden" name="form-name" value="homepage-quote" />
          <input type="hidden" name="bot-field" />
          <input
            type="text"
            name="name"
            placeholder="Name"
            class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
          />
          <input
            type="tel"
            name="phone"
            placeholder="Phone"
            class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
          />

          <div class="mt-2 flex flex-col gap-2.5">
            <button
              type="submit"
              class="inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-primary)] px-6 py-3 text-center text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]"
            >
              {content.primaryCta.label}
            </button>
            <a
              href={content.secondaryCta.href}
              class="inline-flex w-full items-center justify-center rounded-lg border border-white bg-white px-4 py-3 text-center text-[0.95rem] leading-5 font-extrabold text-black transition hover:bg-white/90 sm:px-6 sm:text-sm sm:leading-normal"
            >
              {content.secondaryCta.label}
            </a>
          </div>
        </form>
      </aside>
    </div>
  </div>

  <div class="section-shell lg:hidden">
    <div id="mobile-quote-form" class="rounded-xl border border-white/12 bg-[rgba(25,24,27,0.94)] p-5 shadow-[0_24px_80px_rgba(0,0,0,0.28)] backdrop-blur-md">
      <p class="text-[0.78rem] font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">Contact Us</p>
      <h2 class="mt-2 text-[1.9rem] font-extrabold leading-tight text-white">Request a Quote</h2>
      <p class="mt-2 text-[0.92rem] leading-6 text-white/72">
        Share a few details and our team can follow up about your facility, timing, and project needs.
      </p>

      <form
        name="homepage-quote"
        action="/"
        method="post"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-4 grid gap-2.5"
      >
        <input type="hidden" name="form-name" value="homepage-quote" />
        <input type="hidden" name="bot-field" />
        <input
          type="text"
          name="name"
          placeholder="Name"
          class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
        />
        <input
          type="email"
          name="email"
          placeholder="Email"
          class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
        />
        <input
          type="tel"
          name="phone"
          placeholder="Phone"
          class="rounded-lg border border-white/12 bg-white/6 px-4 py-2.5 text-sm text-white outline-none transition placeholder:text-white/36 focus:border-[var(--color-primary)]"
        />

        <button
          type="submit"
          class="mt-2 inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-primary)] px-6 py-3 text-center text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]"
        >
          {content.primaryCta.label}
        </button>
      </form>
    </div>
  </div>
</section>

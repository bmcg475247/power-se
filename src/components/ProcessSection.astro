---
import type { HomepageContent } from "../types/content";

type Props = {
  content: HomepageContent["cta"];
};

const { content } = Astro.props;
---

<section id="cta" class="section-shell scroll-mt-28 py-20 md:scroll-mt-32 md:py-28">
  <div class="cta-box-lite text-left">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="text-[0.78rem] font-extrabold uppercase tracking-[0.22em] text-[var(--color-primary)]">Project Inquiry</p>
        <h2 class="display-font mt-4 max-w-xl text-4xl leading-tight text-white md:text-5xl">{content.title}</h2>
        <p class="mt-5 max-w-xl text-base leading-8 text-white/88 md:text-lg">{content.description}</p>

        <div class="mt-8 rounded-xl border border-white/10 bg-white/6 p-5">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-white/78">Prefer to talk?</p>
          <a
            href={content.secondaryCta.href}
            class="mt-3 inline-flex w-full items-center justify-center rounded-lg border border-white/24 bg-[var(--color-surface)] px-5 py-3 text-center text-sm font-extrabold text-white transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] sm:w-auto"
          >
            {content.secondaryCta.label}
          </a>
        </div>
      </div>

      <form
        name="project-inquiry"
        action="/"
        method="post"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="rounded-2xl border border-white/12 bg-white/[0.07] p-5 shadow-[0_24px_80px_rgba(0,0,0,0.22)] backdrop-blur-md sm:p-6"
      >
        <input type="hidden" name="form-name" value="project-inquiry" />
        <p class="hidden">
          <label>Do not fill this out if you are human: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">Name</span>
            <input
              type="text"
              name="name"
              placeholder="Your name"
              required
              class="w-full rounded-lg border border-white/12 bg-white/10 px-4 py-3 text-sm text-white outline-none transition placeholder:text-white/58 focus:border-[var(--color-primary)]"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">Company</span>
            <input
              type="text"
              name="company"
              placeholder="Company name"
              class="w-full rounded-lg border border-white/12 bg-white/10 px-4 py-3 text-sm text-white outline-none transition placeholder:text-white/58 focus:border-[var(--color-primary)]"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">Email</span>
            <input
              type="email"
              name="email"
              placeholder="you@company.com"
              required
              class="w-full rounded-lg border border-white/12 bg-white/10 px-4 py-3 text-sm text-white outline-none transition placeholder:text-white/58 focus:border-[var(--color-primary)]"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">Phone</span>
            <input
              type="tel"
              name="phone"
              placeholder="+1 (___) ___-____"
              class="w-full rounded-lg border border-white/12 bg-white/10 px-4 py-3 text-sm text-white outline-none transition placeholder:text-white/58 focus:border-[var(--color-primary)]"
            />
          </label>
        </div>

        <label class="mt-4 block">
          <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">What do you need help with?</span>
          <select
            name="project_type"
            class="w-full rounded-lg border border-white/12 bg-[#2b2a2e] px-4 py-3 text-sm text-white outline-none transition focus:border-[var(--color-primary)]"
          >
            <option value="">Select a project type</option>
            <option>Arc flash study</option>
            <option>Power system study</option>
            <option>Engineering investigation</option>
            <option>Electrical safety compliance</option>
            <option>Not sure yet</option>
          </select>
        </label>

        <label class="mt-4 block">
          <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.18em] text-white/78">Project information</span>
          <textarea
            name="project_information"
            rows="6"
            placeholder="Tell us about your facility, timeline, issue, or any equipment/project details you already know."
            required
            class="w-full resize-y rounded-lg border border-white/12 bg-white/10 px-4 py-3 text-sm leading-6 text-white outline-none transition placeholder:text-white/58 focus:border-[var(--color-primary)]"
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-primary)] px-7 py-4 text-sm font-extrabold text-black transition hover:bg-[var(--color-mist)]"
        >
          Send Project Information
        </button>

        <p class="mt-3 text-center text-xs leading-5 text-white/80">
          Your request will be captured securely through Netlify form submissions.
        </p>
      </form>
    </div>
  </div>
</section>
